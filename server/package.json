{
  "name": "server",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:express --external:socket.io --external:better-sqlite3 --external:jsonwebtoken --external:zod --external:nodemailer --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@zapzap/shared": "*",
    "better-sqlite3": "^11.7.0",
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/nodemailer": "^6.4.17",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.24.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  }
}
