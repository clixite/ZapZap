# Port d'écoute du serveur Node
PORT=3000

# URL publique du site (base des liens d'invitation /j/CODE)
PUBLIC_URL=https://zapzap.clixite-prod.cloud

# Secret de signature des jetons — générer avec : openssl rand -hex 32
# Obligatoire en production ; en développement, une valeur de repli est utilisée.
JWT_SECRET=change-me

# Chemin du fichier SQLite (comptes, statistiques, parties en cours)
DB_PATH=./data/zapzap.db

# Délai avant qu'un joueur automatique ne joue (0 = instantané).
# Un robot instantané donne l'impression d'un bug plutôt que d'un joueur.
BOT_DELAY_MS=800

# Temps laissé à un joueur avant que son tour ne se joue tout seul.
# En temps réel uniquement : en asynchrone, personne n'est joué à sa place.
TURN_TIMEOUT_MS=45000

# Délai de grâce avant de considérer qu'un joueur déconnecté a quitté
DISCONNECT_GRACE_MS=60000
